# Django settings
DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,web

# PostgreSQL settings (for db service)
POSTGRES_DB=openfinance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database URL for Django (using the service name 'db' from docker-compose)
DATABASE_URL=postgres://postgres:postgres@db:5432/openfinance
